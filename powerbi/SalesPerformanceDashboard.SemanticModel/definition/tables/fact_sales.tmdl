table fact_sales
	lineageTag: 81578427-cb62-46c6-b4ce-cc0f657a4927

	measure 'Total Sales' = SUM(fact_sales[sales])
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: 61e5b46b-fcc6-4c66-ae59-6e90bb18464a

	measure 'Total Profit' = SUM(fact_sales[profit])
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: fed2bb37-3448-48ef-ac0d-40d23575cc84

	measure 'Total Orders' = DISTINCTCOUNT(fact_sales[order_id])
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: cb5b3a4f-3aff-445e-89f8-68ef0d00a2de

	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales], 0)
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: efdd966d-4688-4fb0-a270-b6d2df88b5b4

