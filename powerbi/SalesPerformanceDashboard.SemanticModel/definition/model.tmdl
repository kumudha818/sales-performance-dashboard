model SalesPerformanceDashboard
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US

    annotation PBI_QueryOrder = 0

    table fact_sales
        lineageTag: 81578427-cb62-46c6-b4ce-cc0f657a4927

        measure 'Total Sales' = SUM(fact_sales[sales])
            formatString: $#,##0.00
            displayFolder: KPIs

        measure 'Total Profit' = SUM(fact_sales[profit])
            formatString: $#,##0.00
            displayFolder: KPIs

        measure 'Total Orders' = DISTINCTCOUNT(fact_sales[order_id])
            formatString: #,##0
            displayFolder: KPIs

        measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales], 0)
            formatString: 0.00%
            displayFolder: KPIs

        column row_id
            dataType: int64
            isKey
            summarizeBy: none

        column order_id
            dataType: string
            summarizeBy: none

        column order_date
            dataType: dateTime
            summarizeBy: none

        column order_month
            dataType: dateTime
            summarizeBy: none

        column ship_date
            dataType: dateTime
            summarizeBy: none

        column ship_mode
            dataType: string
            summarizeBy: none

        column customer_id
            dataType: string
            summarizeBy: none

        column customer_name
            dataType: string
            summarizeBy: none

        column segment
            dataType: string
            summarizeBy: none

        column country
            dataType: string
            summarizeBy: none

        column state
            dataType: string
            summarizeBy: none

        column city
            dataType: string
            summarizeBy: none

        column region
            dataType: string
            summarizeBy: none

        column product_id
            dataType: string
            summarizeBy: none

        column category
            dataType: string
            summarizeBy: none

        column sub_category
            dataType: string
            summarizeBy: none

        column product_name
            dataType: string
            summarizeBy: none

        column sales
            dataType: decimal
            formatString: $#,##0.00

        column quantity
            dataType: int64
            formatString: #,##0

        column discount
            dataType: decimal
            formatString: 0.00%

        column profit
            dataType: decimal
            formatString: $#,##0.00

        partition fact_sales = m
            mode: import
            source = #"LoadSales"
